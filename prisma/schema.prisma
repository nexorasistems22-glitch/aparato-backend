// A Hora do Estilo - Prisma Schema
// PostgreSQL - Multi-tenant SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────
// TENANT / ESTABELECIMENTO
// ─────────────────────────────────────
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  logoUrl     String?
  planType    PlanType @default(STARTER)
  planExpires DateTime?
  isActive    Boolean  @default(true)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]
  products      Product[]
  categories    Category[]
  cashFlows     CashFlow[]
  campaigns     Campaign[]
  loyaltyPoints LoyaltyPoint[]
  workingHours  WorkingHours[]
  units         Unit[]

  @@map("tenants")
}

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─────────────────────────────────────
// UNIDADES (multi-unidade)
// ─────────────────────────────────────
model Unit {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isMain    Boolean @default(false)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals Professional[]
  appointments  Appointment[]

  @@map("units")
}

// ─────────────────────────────────────
// USUÁRIOS (admin/staff do estabelecimento)
// ─────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  RECEPTIONIST
}

// ─────────────────────────────────────
// PROFISSIONAIS
// ─────────────────────────────────────
model Professional {
  id              String  @id @default(uuid())
  tenantId        String
  unitId          String?
  name            String
  email           String?
  phone           String?
  avatarUrl       String?
  bio             String?
  commissionRate  Float   @default(40)
  isActive        Boolean @default(true)
  acceptOnline    Boolean @default(true)
  colorCode       String  @default("#C9A84C")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?         @relation(fields: [unitId], references: [id])
  appointments Appointment[]
  schedules    WorkingHours[]
  services     ProfessionalService[]

  @@map("professionals")
}

// ─────────────────────────────────────
// HORÁRIOS DE TRABALHO
// ─────────────────────────────────────
model WorkingHours {
  id             String  @id @default(uuid())
  tenantId       String
  professionalId String?
  dayOfWeek      Int     // 0=Dom, 1=Seg... 6=Sáb
  startTime      String  // "09:00"
  endTime        String  // "18:00"
  lunchStart     String? // "12:00"
  lunchEnd       String? // "13:00"
  isWorking      Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@map("working_hours")
}

// ─────────────────────────────────────
// CATEGORIAS DE SERVIÇO
// ─────────────────────────────────────
model Category {
  id       String @id @default(uuid())
  tenantId String
  name     String
  iconName String?
  color    String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("categories")
}

// ─────────────────────────────────────
// SERVIÇOS
// ─────────────────────────────────────
model Service {
  id           String  @id @default(uuid())
  tenantId     String
  categoryId   String?
  name         String
  description  String?
  duration     Int     // em minutos
  price        Float
  isActive     Boolean @default(true)
  isOnline     Boolean @default(true)
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?             @relation(fields: [categoryId], references: [id])
  appointments AppointmentService[]
  professionals ProfessionalService[]

  @@map("services")
}

model ProfessionalService {
  professionalId String
  serviceId      String
  customPrice    Float?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

// ─────────────────────────────────────
// CLIENTES
// ─────────────────────────────────────
model Client {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  birthDate   DateTime?
  gender      Gender?
  notes       String?
  avatarUrl   String?
  address     String?
  isActive    Boolean   @default(true)
  totalSpent  Float     @default(0)
  totalVisits Int       @default(0)
  lastVisitAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  loyaltyPoints LoyaltyPoint[]

  @@unique([tenantId, phone])
  @@map("clients")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─────────────────────────────────────
// AGENDAMENTOS
// ─────────────────────────────────────
model Appointment {
  id             String            @id @default(uuid())
  tenantId       String
  unitId         String?
  clientId       String
  professionalId String
  status         AppointmentStatus @default(SCHEDULED)
  date           DateTime
  startTime      String            // "09:00"
  endTime        String            // "09:45"
  totalPrice     Float
  totalDuration  Int               // minutos
  notes          String?
  source         BookingSource     @default(ADMIN)
  reminderSent   Boolean           @default(false)
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?                @relation(fields: [unitId], references: [id])
  client       Client               @relation(fields: [clientId], references: [id])
  professional Professional         @relation(fields: [professionalId], references: [id])
  services     AppointmentService[]
  payment      Payment?

  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ADMIN
  CLIENT_APP
  WHATSAPP
  WEBSITE
  WALK_IN
}

model AppointmentService {
  id            String  @id @default(uuid())
  appointmentId String
  serviceId     String
  price         Float
  duration      Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

// ─────────────────────────────────────
// PAGAMENTOS
// ─────────────────────────────────────
model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  pixCode       String?
  externalId    String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
  LOYALTY_POINTS
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// ─────────────────────────────────────
// FLUXO DE CAIXA
// ─────────────────────────────────────
model CashFlow {
  id          String          @id @default(uuid())
  tenantId    String
  type        CashFlowType
  category    String
  description String
  amount      Float
  date        DateTime        @default(now())
  paymentMethod PaymentMethod?
  referenceId String?
  createdAt   DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("cash_flows")
}

enum CashFlowType {
  INCOME
  EXPENSE
}

// ─────────────────────────────────────
// PRODUTOS / ESTOQUE
// ─────────────────────────────────────
model Product {
  id           String  @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  sku          String?
  costPrice    Float   @default(0)
  salePrice    Float   @default(0)
  stock        Int     @default(0)
  minStock     Int     @default(5)
  unit         String  @default("un")
  imageUrl     String?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

// ─────────────────────────────────────
// FIDELIDADE
// ─────────────────────────────────────
model LoyaltyPoint {
  id          String   @id @default(uuid())
  tenantId    String
  clientId    String
  points      Int
  description String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])

  @@map("loyalty_points")
}

// ─────────────────────────────────────
// CAMPANHAS DE MARKETING
// ─────────────────────────────────────
model Campaign {
  id          String         @id @default(uuid())
  tenantId    String
  title       String
  message     String
  channel     CampaignChannel
  status      CampaignStatus @default(DRAFT)
  targetType  String         @default("all")
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int            @default(0)
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}
