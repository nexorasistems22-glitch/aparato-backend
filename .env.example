# ─── Database ──────────────────────────────────────
# Railway PostgreSQL (preencha com sua URL do Railway)
DATABASE_URL="postgresql://usuario:senha@host:5432/ahoradoestilo"

# ─── JWT ───────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-de-64-caracteres"

# ─── Server ────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend ──────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
# Em produção:
# FRONTEND_URL="https://seu-dominio.vercel.app"

# ─── Email (opcional - Nodemailer) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# ─── WhatsApp (opcional - Z-API ou similar) ────────
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# ─── Storage (opcional - AWS S3 para fotos) ────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=sa-east-1
